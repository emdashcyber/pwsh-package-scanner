{"package":"Invoke-InstalledApplicationManagement","version":"1.1.0","assessment":"complete","packageSha256":"8e40d33f73908fa71aec8e450756fc6159abb5102c63543770548e11f000473d","scannedAt":"2026-10-24T22:56:52.882Z","scannerVersion":"0.2.0","rulesetVersion":"0.3.0","tools":{"powerShell":"7.6.8","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Invoke-InstalledApplicationManagement/1.1.0","metadata":{"title":"Invoke-InstalledApplicationManagement","description":"- Check for apllications installed on the machine with the input Name.\n- If a match is found on the registry, creates an object with its Name, Version and UninstallString.\n- If no match is found on the registry, the Win32_Product CIM/WMI class is queried and an object is created with the app Name, Version and CimInstance.\n- If the Uninstall switch is called, check if the installed version is less than input version and uninstall the application(s).\n- If the ForceUninstall switch is called, uninstall the application(s) without checking the version.","authors":"Francisco Nabas","owners":"UncleCisco","projectUrl":"https://github.com/FranciscoNabas/PowerShell/blob/main/Invoke-InstalledApplicationManagement.ps1","publishedAt":"2021-07-14T12:55:16.223","updatedAt":"2026-10-24T10:00:01.497","tags":["PSScript","PSFunction_Invoke-InstalledApplicationManagement","PSCommand_Invoke-InstalledApplicationManagement","PSFunction_Add-Log","PSCommand_Add-Log","PSFunction_Get-InstalledApplicationManagement","PSCommand_Get-InstalledApplicationManagement","PSFunction_Remove-InstalledApplicationManagement","PSCommand_Remove-InstalledApplicationManagement","PSIncludes_Function"]},"dependencies":[],"binaryArtifacts":[],"fileInventory":[{"path":"_rels/.rels","size":531,"crc32":"df6ca9d6","extension":"rels"},{"path":"Invoke-InstalledApplicationManagement.nuspec","size":1618,"crc32":"46184d09","extension":"nuspec"},{"path":"Invoke-InstalledApplicat