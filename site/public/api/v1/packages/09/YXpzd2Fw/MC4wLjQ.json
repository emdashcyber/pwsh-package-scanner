{"package":"azswap","version":"0.0.4","assessment":"complete","packageSha256":"221b2629a97ea768b01e901ca4455df7914654d27893433a373fa64f87488789","scannedAt":"2026-10-24T08:56:50.226Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/azswap/0.0.4","metadata":{"title":"azswap","description":"Isolated Azure CLI profiles: one identity per shell. The Azure CLI keeps a single current subscription for your whole user account, so az account set in one terminal silently retargets every other terminal, script and agent. azswap gives each tenant identity its own AZURE_CONFIG_DIR folder and points only the current shell (or one command, with azswap run) at it. Profiles remember their tenant, sign-in method and expected account, sign straight back in when a token expires, warn about the wrong account, and never start a sign-in from scripts, CI or agents.","authors":"Joe Pitts","owners":"JoePittsy","projectUrl":"https://github.com/JoePittsy/azswap","publishedAt":"2026-10-14T13:36:51.127","updatedAt":"2026-10-25T02:40:01.337","tags":["Azure","AzureCLI","az","AZURE_CONFIG_DIR","tenant","profile","multi-tenant","login","Windows","Linux","MacOS","PSEdition_Core","PSEdition_Desktop","PSModule","PSFunction_azswap","PSCommand_azswap","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":496,"crc32":"5c89ff9f","extension":"rels"},{"path":"azswap.nuspec","size":3592,"crc32":"b192ea46","extension":"nuspec"},{"path":"azswap.psm1","size":45205,"crc32":"5a9b774c","extension":"psm1"},{"path":"azswap.psd1","size":3775,"crc32":"f0eca10e","extension":"psd1"},{"path":"[Content_Types].xml","size":523,"crc32":"6b57516e","extension":"xml"},{"path":"package/services/metadata/core-properties/f62beeedf9b041d4abd81fabd045fb1b.psmdcp","size":1305,"crc32":"96d1b0bf","extension":"psmdcp"}],"findings":[],"cove