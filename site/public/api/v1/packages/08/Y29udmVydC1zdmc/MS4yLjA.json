{"package":"Convert-SVG","version":"1.2.0","assessment":"complete","packageSha256":"c6669d47e7bf4c557029e74397a4e8a356e29be34a11573161bc066ebfccbecb","scannedAt":"2026-10-24T09:14:20.934Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Convert-SVG/1.2.0","metadata":{"title":"Convert-SVG","description":"This script converts SVG files to PNG or JPG format using Inkscape.\nPNG format preserves transparency, while JPG format does not support transparency\nbut may result in smaller file sizes with white background.\n\nIt also supports the reverse conversion: PNG or JPG to SVG.\nFor PNG-to-SVG conversion, the PNG is embedded as base64 inside the SVG container,\npreserving the original image pixel-perfectly (including transparency for PNG files).\nThis conversion uses built-in .NET APIs (no external dependencies required),\nwith Inkscape as fallback.\n\nRequires Inkscape to be installed on the system (for SVG-to-raster export).\nDownload from: https://inkscape.org/release/","authors":"Giovanni Solone","owners":"Gioxx","projectUrl":"https://github.com/gioxx/Nebula.Scripts/blob/main/Utility/Convert-SVG.ps1","publishedAt":"2026-06-11T12:18:17.407","updatedAt":"2026-10-26T03:00:01.17","tags":["powershell","inkscape","images","conversion","svg","png","jpg","PSScript","PSFunction_Convert-RasterToSvg","PSCommand_Convert-RasterToSvg","PSFunction_Resolve-InkscapePath","PSCommand_Resolve-InkscapePath","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":505,"crc32":"ed39cf03","extension":"rels"},{"path":"Convert-SVG.nuspec","size":1335,"crc32":"0ed9e6a5","extension":"nuspec"},{"path":"Convert-SVG.ps1","size":13020,"crc32":"0affa286","extension":"ps1"},{"path":"[Content_Types].xml","size":465,"crc32":"72f893e7","extension":"xml"},{"path":"package/services/metadata/core-properties/af