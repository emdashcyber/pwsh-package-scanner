{"package":"Invoke-PingLog","version":"1.0","assessment":"complete","packageSha256":"398ef53172dd165933d8b2e3dde80056e316fa5e3591e4142793f58b5b241c79","scannedAt":"2026-10-24T22:51:57.888Z","scannerVersion":"0.2.0","rulesetVersion":"0.2.0","tools":{"powerShell":"7.6.8","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Invoke-PingLog/1.0","metadata":{"title":"Invoke-Pinglog","description":"Tests and monitors network connectivity using ICMP echo packets. Behaviour is similar to the Windows ping command and essentially wraps the Win32_PingStatus WMI class.\r\n\r\nFailure and success responses can be filtered by a chosen threshold to aid monitoring of connections, and logging to a CSV format file is possible. Logs are not effected by filtering.\r\n\r\nIf a domain name resolves to both an IPv4 and an IPv6 address then the IPv6 address will be preferred, this is a behaviour of the Win32_PingStatus class with no option to force either protocol.\r","authors":"Chris Redit","owners":"chrisred","projectUrl":"https://github.com/chrisred/posh-scripts","publishedAt":"2017-08-26T18:51:43.687","updatedAt":"2026-10-24T10:00:01.497","tags":["ping","monitoring","PSScript","PSFunction_Write-Log","PSCommand_Write-Log","PSIncludes_Function"]},"dependencies":[],"binaryArtifacts":[],"fileInventory":[{"path":"_rels/.rels","size":499,"crc32":"236bb09d","extension":"rels"},{"path":"Invoke-PingLog.nuspec","size":1275,"crc32":"33c16648","extension":"nuspec"},{"path":"Invoke-PingLog.ps1","size":14163,"crc32":"7cf8297a","extension":"ps1"},{"path":"package/services/metadata/core-properties/0081e720e00f49baa4093b3fe664684f.psmdcp","size":1257,"crc32":"18bdcca7","extension":"psmdcp"},{"path":"[Content_Types].xml","size":448,"crc32":"2c64e055","extension":"xml"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolution":true,"advisories":true,"binaryScanning":true,"executableBinaries"