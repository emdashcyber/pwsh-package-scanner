{"package":"CopyGPOLinks","version":"1.1","assessment":"complete","packageSha256":"5289d8db5479bd17bf3a53f7c6caa917b574aa61f13bd98368854125f04bdd5d","scannedAt":"2026-10-24T09:15:11.201Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0"},"packageUrl":"https://www.powershellgallery.com/packages/CopyGPOLinks/1.1","metadata":{"title":"CopyGPOLinks","description":"When staging environments in a single AD, it is common to create a new identical OU structure for testing purposes. This structure should match the original one, including all child OUs and their linked GPOs. Copy-GPOLinks copies all linked GPOs from a source OU to a target OU in a given domain. Optionally, it recurses through child OUs and copies their GPOs, too. It also can create missing target child OUs automatically.","authors":"Martin Binder","owners":"Martin_Binder","projectUrl":"","publishedAt":"2017-08-01T13:45:44.703","updatedAt":"2026-10-24T07:20:01.65","tags":["grouppolicy","gplink","gpolinks","PSModule","PSFunction_Copy-GPOLinks","PSCommand_Copy-GPOLinks","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":497,"crc32":"93982490","extension":"rels"},{"path":"CopyGPOLinks.nuspec","size":1150,"crc32":"a1dc9bc7","extension":"nuspec"},{"path":"Copy-GPOLinks.ps1","size":11522,"crc32":"fa8978ca","extension":"ps1"},{"path":"CopyGPOLinks.psd1","size":2292,"crc32":"13cb0718","extension":"psd1"},{"path":"init.ps1","size":200,"crc32":"edc1e019","extension":"ps1"},{"path":"loader.psm1","size":377,"crc32":"e9383dbf","extension":"psm1"},{"path":"package/services/metadata/core-properties/66cfb10617fb43d89e991e3a4273def1.psmdcp","size":1142,"crc32":"7db161db","extension":"psmdcp"},{"path":"[Content_Types].xml","size":568,"crc32":"d55d0ab4","extension":"xml"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolution":true,"advisories":true,"executableBin