{"package":"Optimize-VMDisk","version":"1.0.1","assessment":"complete","packageSha256":"26f2f5232b1e1fb3baccca9f3a165f9fe17f14021383480f529f3af029c40e3a","scannedAt":"2026-10-24T10:28:01.129Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Optimize-VMDisk/1.0.1","metadata":{"title":"Optimize-VMDisk","description":"This script was written as a way of easily performing the Optimize-VHD cmdlet that cleans up previously used space and defrags dynamic VHD and VHDX drives used by Hyper-V VMs. Because this operation requires that the VM be shutdown and the disk be mounted read only it can take some setup to get the disk in the correct state to optimize it. This script will shutdown the VM, mount the disk, optimize the disk, dismount the disk and then start the VM back up. It also provides a report showing the previous, current and amount recovered from the optimization process.","authors":"Dillon Childers","owners":"EntropicTech","projectUrl":"","publishedAt":"2020-07-11T21:49:31.75","updatedAt":"2026-10-24T04:40:01.103","tags":["PSModule","PSFunction_Optimize-VMDisk","PSCommand_Optimize-VMDisk","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":509,"crc32":"f8e4ea81","extension":"rels"},{"path":"Optimize-VMDisk.nuspec","size":1158,"crc32":"ec5e7af6","extension":"nuspec"},{"path":"Optimize-VMDisk.psd1","size":8942,"crc32":"7b3caa97","extension":"psd1"},{"path":"Optimize-VMDisk.psm1","size":8543,"crc32":"5e7acff7","extension":"psm1"},{"path":"README.md","size":1612,"crc32":"75bab6e6","extension":"md"},{"path":"[Content_Types].xml","size":592,"crc32":"5799678d","extension":"xml"},{"path":"package/services/metadata/core-properties/73702b242fb54a4b9b00a573420511f7.psmdcp","size":1254,"crc32":"74efc908","extension":"psmdcp"}],"findings":[],"coverage":{"archive":true,"powerSh