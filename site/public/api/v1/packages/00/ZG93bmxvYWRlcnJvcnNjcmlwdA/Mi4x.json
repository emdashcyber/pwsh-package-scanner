{"package":"DownloadErrorScript","version":"2.1","assessment":"complete","packageSha256":"a722b5b66cbe8c3ef28ec5a7790d364af9d99ef668f18d927fdb9e9fe8ab3e53","scannedAt":"2026-10-24T09:27:05.898Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/DownloadErrorScript/2.1","metadata":{"title":"DownloadErrorScript","description":"This script downloads the item errors in a Microsoft Graph Connectors Connection. An Msal token is generated using the tenant credentials in which the connection is present.\nThat token is then used to first get all the distinct error codes with which the items failed and then for each error code all the item errors are fetched iteratively.\nGetting item errors for a particular error code is a batched API call with default batch size as 250. \n\nToken is generated using MSAL.PS module, while installing this PS script, MSAL.PS module should be installed automatically.\nIf this doesn't happen use the below command to install MSAL.PS\n\nInstall-Module -Name MSAL.PS","authors":"Microsoft Corporation","owners":"vishwagarwal,Sathya_Swathy","projectUrl":"https://learn.microsoft.com/en-us/microsoftsearch/connector-details-errors","publishedAt":"2023-11-07T18:47:56.75","updatedAt":"2026-10-22T17:40:01.273","tags":["Microsoft","Graph","Search","PowerShell","PSScript","PSFunction_GetEnvironmentFromTenant","PSCommand_GetEnvironmentFromTenant","PSFunction_SelectBaseUrl","PSCommand_SelectBaseUrl","PSFunction_InitializeOutputFile","PSCommand_InitializeOutputFile","PSFunction_WriteErrorBatchToOutputFile","PSCommand_WriteErrorBatchToOutputFile","PSFunction_WriteExceptionToOutputFile","PSCommand_WriteExceptionToOutputFile","PSFunction_Invoke-RestMethodWithRetries","PSCommand_Invoke-RestMethodWithRetries","PSFunction_Get-TokenWithRetries","PSCommand_Get-TokenWithRetries","PSIncludes_Function"]},"depe