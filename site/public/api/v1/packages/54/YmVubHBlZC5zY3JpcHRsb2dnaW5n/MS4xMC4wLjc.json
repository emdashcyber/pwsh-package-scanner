{"package":"BenLPed.Scriptlogging","version":"1.10.0.7","assessment":"complete","packageSha256":"f9b28a6f857b20ee08046e39f69577117a2dcafbfbe93b65fd5a83333c04f3d4","scannedAt":"2026-10-24T09:02:15.570Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/BenLPed.Scriptlogging/1.10.0.7","metadata":{"title":"BenLPed.Scriptlogging","description":"This module can help you create logging in your scripts. You can follow along live, which makes it easy to see what is happening. It also records which user runs the script, which line of the script is executed and the time. So if something goes wrong, it s easy to find out what went wrong.\r\n\r\nWhen you want to add something to the log, you write write-log \"what needs to happen or what happens\" and it is added to the log file. By default, it automatically sets 1 after \"Text\", but if you want to draw attention to something, you can write 2 numbers and the error text will turn yellow. If you write a number 3, the text turns red, it is only used in case of error.","authors":"Benni Ladevig Pedersen","owners":"BenniLPedersen","projectUrl":"https://github.com/BenLPed/BenLPed.Scriptlogging","publishedAt":"2024-03-20T13:40:37.273","updatedAt":"2026-10-22T23:00:00.967","tags":["Logging","Logger","Logs","ScriptLog","Scripting","PSModule","PSFunction_Start-Log","PSCommand_Start-Log","PSFunction_Write-Log","PSCommand_Write-Log","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":515,"crc32":"5e6aa808","extension":"rels"},{"path":"BenLPed.Scriptlogging.nuspec","size":1517,"crc32":"77bd19de","extension":"nuspec"},{"path":"Public/Start-Log.ps1","size":4768,"crc32":"ad2f0ff5","extension":"ps1"},{"path":"Public/Write-Log.ps1","size":2080,"crc32":"c1db1d07","extension":"ps1"},{"path":"BenLPed.Scriptlogging.psd1","size":5933,"crc32":"063e4297","extension":"psd1"},{"path":"BenLPed.Scriptlogging.psm1","size":226,"crc32":"35cc8e51","extension":"psm1"},{"path":"LICENSE.txt","size":1073,"crc32":"fa09426d","extension":"txt"},{"path":"README.md","size":3405,"crc32":"a9c3a591","extension":"md"},{"path":"[Content_Types].xml","size":718,"crc32":"2c57f4ad","extension":"xml"},{"path":"package/services/metadata/core-properties/0b227f68cb08483a88ed7fbe7fd031dc.psmdcp","size":1465,"crc32":"932f85bc","extension":"psmdcp"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolution":true,"advisories":true,"executableBinaries":"none-detected","binaryScanning":true},"advisoryCheckedAt":"2026-10-24T09:02:15.570Z","advisoryError":null,"warnings":[],"binaryArtifacts":[],"schemaVersion":"1.1"}