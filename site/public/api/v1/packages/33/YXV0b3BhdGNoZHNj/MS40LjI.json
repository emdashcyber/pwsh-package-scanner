{"package":"AutoPatchDSC","version":"1.4.2","assessment":"complete","packageSha256":"51b202b12cbcfe81de2478b2288f941287b85237a870c7e57e825f33cf7420a5","scannedAt":"2026-10-24T08:12:19.853Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/AutoPatchDSC/1.4.2","metadata":{"title":"AutoPatchDSC","description":"This resource provides automated patch installation during a defined maintenance window, with patches provided by WSUS.  It is designed for use with WaitForAll, WaitForAny, and WaitForAny DSC Resources to facilitate orchestration of rebooting nodes within a Highly Available (HA) configuration.  Alternatively, a controller script may be used to orchestrate HA reboots.  AutoPatchDSC was designed to patch SharePoint farms with mirror/witness configured SQL servers.  However, the resource should be adaptable for farms of any type and SQL clusters.\r\n\r\nThis module is being revised to meet the standards for a High Quality Resource Module (https://github.com/PowerShell/DscResources/blob/master/HighQualityModuleGuidelines.md).","authors":"Chris Madole (chmadole)","owners":"chmadole","projectUrl":"https://github.com/chmadole/AutoPatchDSC","publishedAt":"2017-04-12T07:05:06.893","updatedAt":"2026-10-24T06:20:01.237","tags":["PSModule","PSDscResource_AutoPatchInstall","PSDscResource_AutoPatchReboot","PSDscResource_AutoPatchServices","PSIncludes_DscResource"]},"dependencies":[{"name":"PSWindowsUpdate","versionRange":"*","parent":null,"depth":1,"status":"resolved","resolvedVersion":"2.2.1.5","sourceEcosystem":"NuGet","relation":"requires","declarationSources":["Gallery dependency metadata"],"file":null,"line":null}],"fileInventory":[{"path":"_rels/.rels","size":497,"crc32":"6909213d","extension":"rels"},{"path":"AutoPatchDSC.nuspec","size":1396,"crc32":"31b00474","extension":"nuspec"},{"path":"AutoPatchDSC.p