{"package":"Set-WindowsSpeculativeMitigation","version":"1.0.0","assessment":"complete","packageSha256":"53424945e92aa9220c65d6e04285830791899984b8699841c740e4acc461b289","scannedAt":"2026-10-24T11:26:20.618Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Set-WindowsSpeculativeMitigation/1.0.0","metadata":{"title":"Set-WindowsSpeculativeMitigation","description":"This script sets the Windows registry values FeatureSettingsOverrideMask and\nFeatureSettingsOverride under:\n    HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management\nto mitigate speculative execution vulnerabilities including Spectre, Meltdown,\nL1TF, MDS, TAA, and Intel Branch History Injection (BHI / CVE-2022-0001).\n\nThree mitigation levels are available:\n  Level 1 - All speculative execution CVEs including CVE-2022-0001 with Hyper-Threading enabled (Recommended)\n  Level 2 - All speculative execution CVEs including CVE-2022-0001 with Hyper-Threading disabled\n  Level 3 - CVE-2022-0001 (Intel BHI) only - use only if other speculative execution mitigations are managed separately","authors":"PowerShell Scripts Collection","owners":"skrish58","projectUrl":"","publishedAt":"2026-08-10T14:53:27.72","updatedAt":"2026-10-21T07:42:08.15","tags":["@('SpeculativeExecution'","'Spectre'","'Meltdown'","'BHI'","'Security'","'Windows')","PSScript","PSFunction_Test-Administrator","PSCommand_Test-Administrator","PSFunction_Get-CurrentRegistryValue","PSCommand_Get-CurrentRegistryValue","PSFunction_Set-RegistryDword","PSCommand_Set-RegistryDword","PSFunction_Test-HyperThreadingEnabled","PSCommand_Test-HyperThreadingEnabled","PSFunction_Main","PSCommand_Main","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":526,"crc32":"67108ae5","extension":"rels"},{"path":"Set-WindowsSpeculativeMitigatio