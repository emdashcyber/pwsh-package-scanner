{"package":"Invoke-PSWorkflowController","version":"1.0.22.0","assessment":"complete","packageSha256":"d57c591a30afae5b24e32b67a2de31b2afe3941178541c5fae173558ca7129d0","scannedAt":"2026-10-24T22:53:01.336Z","scannerVersion":"0.2.0","rulesetVersion":"0.2.0","tools":{"powerShell":"7.6.8","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Invoke-PSWorkflowController/1.0.22.0","metadata":{"title":"Invoke-PSWorkflowController","description":"Workflows provide a set of features to the administrator to resolve complex issues when automating\ncomplex tasks. Such as running parallel activities or recoverting jobs after a reboot. In the later\ncase, resuming a job after a reboot can be challenging if the system where the workflow is running\nis the same system that initiated the workflow. This script allows the administrator to execute\nPowerShell workflows under the context of SYSTEM, giving the administrator the chance to 'teach' his\nworkflows to resume themselves after a reboot by using the task scheduling capabilities of the operating\nsystem.","authors":"Hernan J. Larrea (hjlarrea@hotmail.com)","owners":"hjlarrea","projectUrl":"https://www.hernanjlarrea.com/index.php/powershell-workflow-controller/","publishedAt":"2018-10-01T21:04:34.883","updatedAt":"2026-10-24T10:00:01.497","tags":["PowerShell","WorkFlows","SYSTEM","Reboot","Restart","Resume","PSScript"]},"dependencies":[],"binaryArtifacts":[],"fileInventory":[{"path":"_rels/.rels","size":521,"crc32":"9ff5843c","extension":"rels"},{"path":"Invoke-PSWorkflowController.nuspec","size":1288,"crc32":"6088da36","extension":"nuspec"},{"path":"Invoke-PSWorkflowController.ps1","size":8858,"crc32":"0a48ef8a","extension":"ps1"},{"path":"[Content_Types].xml","size":465,"crc32":"72f893e7","extension":"xml"},{"path":"package/services/metadata/core-properties/3388264443e2400085ed4635725cc099.psmdcp","size":1316,"crc32":"d24c9a18","extension":"psmdc