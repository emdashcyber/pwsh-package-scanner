pps\r\n- Reset-HybridADJoin - reset Hybrid AzureAD join connection\r\n- Reset-IntuneEnrollment - reset device Intune management enrollment\r\n- Search-IntuneAccountPolicyAssignment - search user/device/group assigned Intune policies\r\n- Set-AADDeviceExtensionAttribute - set/reset device extension attribute\r\n- Upload-IntuneAutopilotHash - upload given autopilot hash (owner and hostname) into Intune\r\n- ...\r","authors":"@AndrewZtrhgf","owners":"ztrhgf","projectUrl":"https://github.com/ztrhgf/useful_powershell_modules","publishedAt":"2026-10-09T12:35:58.83","updatedAt":"2026-10-25T05:00:01.247","tags":["MEMCM","PowerShell","Intune","MDM","IntuneStuff","PSModule","PSEdition_Core","PSEdition_Desktop","PSFunction_Compare-IntuneSecurityBaseline","PSCommand_Compare-IntuneSecurityBaseline","PSFunction_ConvertFrom-MDMDiagReport","PSCommand_ConvertFrom-MDMDiagReport","PSFunction_ConvertFrom-MDMDiagReportXML","PSCommand_ConvertFrom-MDMDiagReportXML","PSFunction_Get-BitlockerEscrowStatusForAzureADDevices","PSCommand_Get-BitlockerEscrowStatusForAzureADDevices","PSFunction_Get-ClientIntunePolicyResult","PSCommand_Get-ClientIntunePolicyResult","PSFunction_Get-HybridADJoinStatus","PSCommand_Get-HybridADJoinStatus","PSFunction_Get-IntuneAppInstallSummaryReport","PSCommand_Get-IntuneAppInstallSummaryReport","PSFunction_Get-IntuneAuditEvent","PSCommand_Get-IntuneAuditEvent","PSFunction_Get-IntuneConfPolicyAssignmentSummaryReport","PSCommand_Get-IntuneConfPolicyAssignmentSummaryReport","PSFunction_Get-IntuneDeviceAutopilotHashViaRemediation","PSCommand_Get-IntuneDeviceAutopilotHashViaRemediation","PSFunction_Get-IntuneDeviceComplianceStatus","PSCommand_Get-IntuneDeviceComplianceStatus"]},"dependencies":[{"name":"Az.Accounts","versionRange":"*","relation":"requires","declarationSources":["nuspec","RequiredModules"],"file":"IntuneStuff.psd1","line":78,"parent":null,"depth":1,"status":"resolved","resolvedVersion":"5.5.3","sourceEcosystem":"NuGet"},{"name":"Microsoft.Graph.Authenticati