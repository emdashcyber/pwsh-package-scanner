{"package":"WebsiteFailedLogins","version":"2.0","assessment":"complete","packageSha256":"85ec01b9143c4f50589f6aaa40491d68003575ece6ebe48a6a3a60116c2c7716","scannedAt":"2026-10-24T11:57:55.647Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/WebsiteFailedLogins/2.0","metadata":{"title":"WebsiteFailedLogins","description":"This PowerShell module was created to identify the following scenarios affecting IIS hosted websites.\n\n1. Brute Force Login Attempts - excessive failed logins from a single IP address and often targeting a single account.\n2. Password Spraying Attempts - excessive failed logins from a single IP address using a single password across multiple user accounts.\n3. Distributed Login Attempts - either of the above techniques being sourced from multiple IP addresses.\n\nIt leverages Microsoft Logparser and a configuration file to parse the target website's IIS logs. When a threshold is met or exceeded an alert is generated via standard out, email, and/or written to a Windows Event Log. No changes are needed on the webserver. This module can even run on a separate system where there's access to the IIS logs.\n\nCheckout the wiki for details: https://github.com/phbits/WebsiteFailedLogins/wiki","authors":"phbits","owners":"phbits","projectUrl":"https://github.com/phbits/WebsiteFailedLogins","publishedAt":"2021-03-13T02:03:18.21","updatedAt":"2026-10-22T21:40:01.133","tags":["IIS","Logparser","W3SVC","Logs","FailedLogin","BruteForce","PasswordSpray","Detection","IDS","PSModule","PSFunction_Invoke-WebsiteFailedLogins","PSCommand_Invoke-WebsiteFailedLogins","PSFunction_Get-WebsiteFailedLoginsReadme","PSCommand_Get-WebsiteFailedLoginsReadme","PSFunction_Copy-WebsiteFailedLoginsReadme","PSCommand_Copy-WebsiteFailedLoginsReadme","PSFunction_Get-WebsiteFailedLoginsDefaultConfiguration","PSCommand_Get-WebsiteFailedLoginsDefaultConfiguration","PSFunction_Copy-WebsiteFailedLoginsDefaultConfiguration","PSCommand_Copy-WebsiteFailedLoginsDefaultConfiguration","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":513,"crc32":"62a2fa30","extension":"rels"},{"path":"WebsiteFailedLogins.nuspec","size":3002,"crc32":"ded22bb4","extension":"nuspec"},{"path":"LICENSE","size":1063,"crc32":"e4e76201","extension":"license"},{"path":"README.md","size":13827,"crc32":"7185dfba","extension":"md"},{"path":"WebsiteFailedLogins.psd1","size":3542,"crc32":"9fbe2bfb","extension":"psd1"},{"path":"WebsiteFailedLogins.psm1","size":9772,"crc32":"191123d5","extension":"psm1"},{"path":"Resources/WebsiteFailedLogins.alert.psm1","size":6685,"crc32":"a41b0f77","extension":"psm1"},{"path":"Resources/WebsiteFailedLogins.config.psm1","size":42897,"crc32":"d576c274","extension":"psm1"},{"path":"Resources/WebsiteFailedLogins.logins.psm1","size":4161,"crc32":"64f8d42d","extension":"psm1"},{"path":"Resources/WebsiteFailedLogins.lp.psm1","size":3237,"crc32":"382cc554","extension":"psm1"},{"path":"Resources/WebsiteFailedLogins_default.ini","size":2250,"crc32":"f8a8c4a2","extension":"ini"},{"path":"[Content_Types].xml","size":723,"crc32":"bb08e3a0","extension":"xml"},{"path":"package/services/metadata/core-properties/ffb1b017eca64860b08c64eef3fa5194.psmdcp","size":2100,"crc32":"ec894af4","extension":"psmdcp"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolution":true,"advisories":true,"executableBinaries":"none-detected","binaryScanning":true},"advisoryCheckedAt":"2026-10-24T11:57:55.647Z","advisoryError":null,"warnings":[],"binaryArtifacts":[],"schemaVersion":"1.1"}