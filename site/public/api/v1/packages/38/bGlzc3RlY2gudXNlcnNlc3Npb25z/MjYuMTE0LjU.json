{"package":"LISSTech.UserSessions","version":"26.114.5","assessment":"complete","packageSha256":"69dfd26f1e370cbb25b419898f1c5791f60a1bfd011f364bc769122268a96a85","scannedAt":"2026-10-24T10:03:35.849Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/LISSTech.UserSessions/26.114.5","metadata":{"title":"LISSTech.UserSessions","description":"Enumerate and manage Windows Terminal Services user sessions across your estate,\r\nvia the WTSEnumerateSessions Win32 API. Three cmdlets:\r\n\r\n  Find-UserSession  : emits session objects (pipeline-friendly, scriptable)\r\n  Show-UserSession  : renders a rich terminal report with async parallel logoff\r\n                      and an optional ticket-ready HTML report\r\n  Stop-UserSession  : pipeline-bound WTSLogoffSession wrapper\r\n\r\nDesigned for MSP maintenance-window workflows — scan a domain, filter sessions,\r\nlog them off in bulk with live progress, and drop a ticket-ready summary on\r\nthe clipboard. Works on Windows PowerShell 5.1 / Server 2016+ with no external\r\nmodule dependencies (AD lookups use DirectorySearcher).","authors":"LISS Technologies","owners":"mwisniowski","projectUrl":"https://github.com/LISSConsulting/LISSTech.UserSessions","publishedAt":"2026-04-24T23:23:28.257","updatedAt":"2026-10-23T05:00:01.55","tags":["TerminalServices","RDP","Sessions","MSP","WTS","LISSTech","PSModule","PSEdition_Desktop","PSEdition_Core","PSFunction_Find-UserSession","PSCommand_Find-UserSession","PSFunction_Show-UserSession","PSCommand_Show-UserSession","PSFunction_Stop-UserSession","PSCommand_Stop-UserSession","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":515,"crc32":"26b22496","extension":"rels"},{"path":"LISSTech.UserSessions.nuspec","size":4066,"crc32":"ab511adc","extension":"nuspec"},{"path":"CHANGELOG.md","size":