{"package":"Search-Dictionary","version":"1.0","assessment":"complete","packageSha256":"47c1aed12e99a255e143978641ebd37a95074437c4ef0c17dadb1a84966dfaab","scannedAt":"2026-10-24T11:22:46.726Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/Search-Dictionary/1.0","metadata":{"title":"Search-Dictionary","description":"This uses dictionaryapi.dev to obtain the information displayed to you. To my knowledge no dictionary checkers are available as a module on the Powershell Gallery, due to my fondness of the English language and always looking for the most appropriate word to use, I thought creating a module to do just that would be a jolly good idea. This will return the definition of the word, an example of using the word, an audio clip of the phonetics of the word and finally a web link to wiktionary.org to find out even more information on this word you search for. Not every result contains examples and audio.","authors":"Adam Bacon","owners":"psdevuk","projectUrl":"https://adam-bacon.netlify.app/","publishedAt":"2022-08-15T14:09:00.3","updatedAt":"2026-10-22T23:40:11.36","tags":["Dictionary","Spelling","API","PSModule","PSFunction_Search-Dictionary","PSCommand_Search-Dictionary","PSIncludes_Function"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":511,"crc32":"762e55f6","extension":"rels"},{"path":"Search-Dictionary.nuspec","size":1363,"crc32":"a15e04fe","extension":"nuspec"},{"path":"Search-Dictionary.psd1","size":9994,"crc32":"99173ac8","extension":"psd1"},{"path":"Search-Dictionary.psm1","size":3596,"crc32":"4a5092d9","extension":"psm1"},{"path":"[Content_Types].xml","size":530,"crc32":"9faf301f","extension":"xml"},{"path":"package/services/metadata/core-properties/b92ba1f0f9f84017b2b5e5b2294482bd.psmdcp","size":1348,"crc32":"8dbabcf7","extension":"psmdcp"}],"findings":[],"covera