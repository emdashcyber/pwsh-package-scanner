{"package":"MyDefaults","version":"1.0.0.0","assessment":"complete","packageSha256":"c0ca173198f7c6164f3ccbc7eb0753e959144d7e9c0d5790e0c1ddb885cbe35d","scannedAt":"2026-10-25T01:12:26.978Z","scannerVersion":"0.2.0","rulesetVersion":"0.2.0","tools":{"powerShell":"7.6.8","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0","clamav":null},"packageUrl":"https://www.powershellgallery.com/packages/MyDefaults/1.0.0.0","metadata":{"title":"MyDefaults","description":"Sets and gets default values for function parameters. Complete Get-Help is included.\r\nWhen you create a function with a parameter, instead of hardcoding the default value into the code, you can get it from a MyDefaults.xml file at run time. For example the function ABC might have the following parameter defined:\r\n$UserName=(Get-MyDefault 'UserName')\r\nIf the user supplies -UserName when ABC is called, that value is used.  If the user does not supply the value, then it is looked up from the MyDefaults.xml file at run time.","authors":"David T. Bishop","owners":"Menkalos","projectUrl":"","publishedAt":"2014-05-07T19:39:44.083","updatedAt":"2026-10-24T10:20:01.193","tags":["Defaults","Functions"]},"dependencies":[],"binaryArtifacts":[],"fileInventory":[{"path":"_rels/.rels","size":495,"crc32":"7074ddab","extension":"rels"},{"path":"MyDefaults.nuspec","size":1517,"crc32":"00b5f9c2","extension":"nuspec"},{"path":"MyDefaults.psd1","size":915,"crc32":"70cd2d93","extension":"psd1"},{"path":"MyDefaults.psm1","size":6267,"crc32":"cc2be4e1","extension":"psm1"},{"path":"package/services/metadata/core-properties/15127555940147a4a09a49377eca85a3.psmdcp","size":649,"crc32":"aa2664bf","extension":"psmdcp"},{"path":"[Content_Types].xml","size":509,"crc32":"4154d586","extension":"xml"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolution":true,"advisories":true,"binaryScanning":true,"executableBinaries":"none-detected"},"advisoryCheckedAt":"2026-10-25T01:12:26.978Z","advisoryEr