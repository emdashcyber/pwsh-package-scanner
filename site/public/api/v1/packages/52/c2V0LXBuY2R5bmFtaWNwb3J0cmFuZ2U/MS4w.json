{"package":"Set-PncDynamicPortRange","version":"1.0","assessment":"complete","packageSha256":"21167f3122047a2b5971f7e8a99e52c0d525c787dac026a03cb131df472dd3ce","scannedAt":"2026-10-24T11:26:02.179Z","scannerVersion":"0.1.0","rulesetVersion":"0.1.0","tools":{"powerShell":"7.5.12","psscriptAnalyzer":"1.25.0","psscriptAnalyzerExpected":"1.25.0"},"packageUrl":"https://www.powershellgallery.com/packages/Set-PncDynamicPortRange/1.0","metadata":{"title":"Set-PncDynamicPortRange","description":"Servers running the Microsoft Entra Private Network Connector service (WAPCSvc) may exhaust the default Windows\ndynamic port range under heavy load, resulting in failed connections. This script expands the dynamic port range\nfor both TCP and UDP over IPv4 and IPv6 to ports 10000-65535, increasing the number of available ephemeral ports.\n\nThe script first validates that the Entra Private Network Connector service is present and running and makes no\nchanges otherwise. A server restart is required for the changes to take effect.","authors":"Richard Hicks","owners":"richardhicks","projectUrl":"https://github.com/richardhicks/gsa/blob/main/Set-PncDynamicPortRange.ps1","publishedAt":"2026-07-28T01:15:53.613","updatedAt":"2026-10-17T19:00:01.1","tags":["Entra","PrivateNetworkConnector","PrivateAccess","GlobalSecureAccess","DynamicPortRange","ZTNA","ZeroTrust","TCP","UDP","IPv4","IPv6","PSScript"]},"dependencies":[],"fileInventory":[{"path":"_rels/.rels","size":517,"crc32":"411366f5","extension":"rels"},{"path":"Set-PncDynamicPortRange.nuspec","size":1419,"crc32":"07e295bc","extension":"nuspec"},{"path":"Set-PncDynamicPortRange.ps1","size":17172,"crc32":"e77f569e","extension":"ps1"},{"path":"[Content_Types].xml","size":465,"crc32":"72f893e7","extension":"xml"},{"path":"package/services/metadata/core-properties/a9cefe89afac4fbc9e0d65f664c00bfe.psmdcp","size":1306,"crc32":"429a2061","extension":"psmdcp"}],"findings":[],"coverage":{"archive":true,"powerShellAnalysis":true,"dependencyResolu