{
  "openapi": "3.1.0",
  "info": {
    "title": "PowerShell Gallery Scanner API",
    "version": "1.0.0",
    "description": "Read-only static research data. Findings are indicators for review, not proof that a package is malicious."
  },
  "servers": [
    { "url": "https://emdashcyber.com/pwsh-package-scanner/api/v1" }
  ],
  "paths": {
    "/manifest.json": {
      "get": {
        "summary": "Dataset freshness, coverage, and catalog shard locations",
        "responses": {
          "200": {
            "description": "Dataset manifest",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Manifest" } } }
          }
        }
      }
    },
    "/shards/{shard}.json": {
      "get": {
        "summary": "Catalog records for one package-name shard",
        "parameters": [
          { "name": "shard", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-f]{2}$" } }
        ],
        "responses": {
          "200": {
            "description": "Searchable package catalog shard",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogShard" } } }
          }
        }
      }
    },
    "/packages/{packageKey}/{versionKey}.json": {
      "get": {
        "summary": "Scan details for one package version",
        "parameters": [
          { "name": "packageKey", "in": "path", "required": true, "schema": { "type": "string", "description": "Base64url-encoded, lowercased package ID." } },
          { "name": "versionKey", "in": "path", "required": true, "schema": { "type": "string", "description": "Base64url-encoded version string." } }
        ],
        "responses": {
          "200": {
            "description": "Package-version scan result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PackageVersion" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Manifest": {
        "type": "object",
        "required": ["schemaVersion", "status", "coverage", "shards", "stateShards"],
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.0" },
          "status": { "type": "string", "enum": ["ready", "degraded", "bootstrap_required"] },
          "sourceStatus": { "type": "string", "enum": ["available", "degraded"] },
          "generatedAt": { "type": ["string", "null"], "format": "date-time" },
          "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
          "lastSuccessfulScan": { "type": ["string", "null"], "format": "date-time" },
          "galleryUpdatedThrough": { "type": ["string", "null"], "format": "date-time" },
          "advisoriesUpdatedAt": { "type": ["string", "null"], "format": "date-time" },
          "bootstrap": { "type": "object", "properties": { "complete": { "type": "boolean" }, "afterId": { "type": "string" }, "startedAt": { "type": ["string", "null"], "format": "date-time" } } },
          "reconciliation": { "type": "object", "properties": { "afterId": { "type": "string" } } },
          "coverage": { "$ref": "#/components/schemas/Coverage" },
          "shards": { "type": "array", "items": { "type": "string", "pattern": "^shards/[0-9a-f]{2}\\.json$" } },
          "stateShards": { "type": "array", "items": { "type": "string", "pattern": "^state/[0-9a-f]{2}\\.json$" } },
          "notice": { "type": "string" }
        }
      },
      "Coverage": {
        "type": "object",
        "required": ["listedPackages", "scannedLatestVersions", "scannedVersions", "incompleteVersions", "unscannedLatestVersions", "notScannedVersions"],
        "properties": {
          "listedPackages": { "type": "integer", "minimum": 0 },
          "scannedLatestVersions": { "type": "integer", "minimum": 0 },
          "scannedVersions": { "type": "integer", "minimum": 0 },
          "incompleteVersions": { "type": "integer", "minimum": 0 },
          "unscannedLatestVersions": { "type": "integer", "minimum": 0 },
          "notScannedVersions": { "type": "integer", "minimum": 0 }
        }
      },
      "CatalogShard": {
        "type": "object",
        "required": ["schemaVersion", "shard", "packages"],
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.0" },
          "shard": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
          "packages": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogPackage" } }
        }
      },
      "CatalogPackage": {
        "type": "object",
        "required": ["name", "latestVersion", "latestAssessment", "latestFindingCount", "versions"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "owners": { "type": "string" },
          "projectUrl": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "latestVersion": { "type": ["string", "null"] },
          "latestAssessment": { "$ref": "#/components/schemas/Assessment" },
          "latestFindingCount": { "type": "integer", "minimum": 0 },
          "highestSeverity": { "type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null] },
          "latestScannedAt": { "type": ["string", "null"], "format": "date-time" },
          "latestResultPath": { "type": ["string", "null"] },
          "versionCount": { "type": "integer", "minimum": 0 },
          "versionInventoryComplete": { "type": "boolean" },
          "versionInventoryNote": { "type": ["string", "null"] },
          "versions": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogVersion" } }
        }
      },
      "CatalogVersion": {
        "type": "object",
        "required": ["version", "assessment"],
        "properties": {
          "version": { "type": "string" },
          "assessment": { "$ref": "#/components/schemas/Assessment" },
          "scannedAt": { "type": ["string", "null"], "format": "date-time" },
          "publishedAt": { "type": ["string", "null"], "description": "Gallery-provided publication timestamp; preserved as supplied by the feed." },
          "updatedAt": { "type": ["string", "null"], "description": "Gallery-provided update timestamp; preserved as supplied by the feed." },
          "findingCount": { "type": "integer", "minimum": 0 },
          "highestSeverity": { "type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null] },
          "resultPath": { "type": "string", "description": "Omitted when assessment is not_scanned; no per-version result document is emitted for pre-launch versions." }
        }
      },
      "Assessment": { "type": "string", "enum": ["complete", "incomplete", "not_scanned"] },
      "PackageVersion": {
        "type": "object",
        "description": "Per-version result documents are published for scanned versions. Known pre-launch versions remain listed with not_scanned assessments in the catalog and do not have separate result documents.",
        "required": ["schemaVersion", "package", "version", "assessment", "findings", "dependencies", "coverage"],
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.0" },
          "package": { "type": "string" },
          "version": { "type": "string" },
          "assessment": { "$ref": "#/components/schemas/Assessment" },
          "packageSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "scannedAt": { "type": ["string", "null"], "format": "date-time" },
          "scannerVersion": { "type": ["string", "null"] },
          "rulesetVersion": { "type": ["string", "null"] },
          "tools": { "type": "object", "properties": { "powerShell": { "type": ["string", "null"] }, "psscriptAnalyzer": { "type": ["string", "null"] }, "psscriptAnalyzerExpected": { "type": "string" } } },
          "metadata": { "type": "object" },
          "dependencies": { "type": "array", "items": { "$ref": "#/components/schemas/Dependency" } },
          "fileInventory": { "type": "array", "items": { "type": "object", "required": ["path", "size", "extension"] } },
          "coverage": { "type": "object" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "$ref": "#/components/schemas/Finding" } }
        }
      },
      "Dependency": {
        "type": "object",
        "required": ["name", "versionRange", "status"],
        "properties": {
          "name": { "type": "string" },
          "versionRange": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "depth": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["resolved", "unresolved", "unsupported_range", "gallery_unavailable", "no_matching_version", "depth_limit", "node_limit"] },
          "resolvedVersion": { "type": ["string", "null"] },
          "sourceEcosystem": { "type": "string" }
        }
      },
      "Finding": {
        "type": "object",
        "required": ["id", "category", "severity", "confidence", "title", "evidence", "references"],
        "properties": {
          "id": { "type": "string" },
          "advisoryId": { "type": "string" },
          "ruleId": { "type": "string" },
          "category": { "type": "string", "enum": ["advisory", "static_rule", "behavior", "supply_chain", "secret"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": ["object", "null"], "properties": { "file": { "type": ["string", "null"] }, "line": { "type": ["integer", "null"] }, "snippet": { "type": "string" } } },
          "references": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    }
  }
}
