{
  "name": "pwsh-package-scanner",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "scan": "node scripts/scan-gallery.js",
    "scan:bootstrap": "node scripts/scan-gallery.js --bootstrap",
    "scan:bootstrap:local": "node scripts/scan-gallery.js --bootstrap-local",
    "scan:recover-incomplete": "node scripts/scan-gallery.js --recover-incomplete",
    "scan:recover-incomplete:restart": "node scripts/scan-gallery.js --recover-incomplete --restart",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm test && npm --prefix site run check"
  }
}
